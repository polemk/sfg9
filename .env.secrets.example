# Exemplo de configuração de segredos locais (.env.secrets)
# IMPORTANTE: Copie este arquivo para .env.secrets e NÃO VERSIONE NO GIT!
# O .env.secrets já está no .gitignore.

# ----------------- #
# Frontend & Auth   #
# ----------------- #
VITE_APP_NAME="YOUR_APP_NAME_HERE"
VITE_GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_HERE"

# ----------------- #
# Backend Security  #
# ----------------- #
DEVISE_JWT_SECRET_KEY="YOUR_DEVISE_JWT_SECRET_KEY_HERE"
SECRET_KEY_BASE="YOUR_SECRET_KEY_BASE_HERE"

# ----------------- #
#  Integration APIs #
# ----------------- #
# Dica: Na sua chave Asaas original proteja o '$' usando aspas simples:
# ASAAS_API_KEY='$aact_prod_...'
ASAAS_API_KEY="YOUR_ASAAS_API_KEY_HERE"

# Evolution API / WhatsApp
WHATS_SERVER_TYPE="https"
WHATS_SERVER_URL="https://whats.example.com"
WHATS_AUTHENTICATION_API_KEY="YOUR_WHATS_AUTHENTICATION_API_KEY_HERE"
WHATS_CONFIG_SESSION_PHONE_CLIENT="Example API"
WHATS_CONFIG_SESSION_PHONE_NAME="YOUR_PHONE_NAME_HERE"

# ----------------- #
# SMTP / E-mail     #
# ----------------- #
SMTP_ADDRESS="mail.example.com"
SMTP_PORT="587"
SMTP_USERNAME="user@example.com"
SMTP_SENDER="user@example.com"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD_HERE"
SMTP_AUTHENTICATION="login"
SMTP_DOMAIN="example.com"
SMTP_TLS_ENABLED="true"
SMTP_DELIVERING="async"
MAILER_FROM="user@example.com"
