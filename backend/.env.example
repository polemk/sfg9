# =============================================================================
# Safegold (sfg9) — contrato de configuração do backend
# =============================================================================
#
# ESTE É O ÚNICO ARQUIVO DE CONFIGURAÇÃO VERSIONADO. Nenhum valor real entra aqui:
# o que vale é o NOME da variável, o formato e o que acontece quando ela falta.
#
# Por que existe um contrato, e não só um punhado de defaults (OPS-609/610/611):
# no legado o `secret_key_base` estava commitado em texto puro
# (`config/development_credentials.yml:1`) e o `credentials.yml.enc` existia SEM
# `master.key` — cifrado e inútil, sem ninguém perceber, porque o Rails cai no caminho
# não cifrado. O resultado é um sistema que sobe em produção com o segredo de
# desenvolvimento e nada quebra.
#
# Aqui **o boot falha** quando falta obrigatória (`config/initializers/required_env.rb`),
# e a mensagem nomeia TODAS as ausentes de uma vez. A lista é por ambiente:
#
#   development  SECRET_KEY_BASE, DEVISE_JWT_SECRET_KEY, REDIS_URL, APP_NAME
#   test         nenhuma — a suíte de caracterização financeira (contrato C2) roda sem
#                nenhuma variável de integração externa definida
#   production   as de development + CORS_ORIGINS, APP_HOST, API_HOST,
#                ACTION_CABLE_URL e as três ACTIVE_RECORD_ENCRYPTION_*
#
# Escape para imagem de build que ainda não tem os segredos: SKIP_ENV_CHECK=true.
#
# ⚠ ROTAÇÃO PENDENTE NO CUTOVER (ação externa, fora deste repositório): os três
# segredos do legado que estão comprometidos por terem sido versionados — token da
# ReceitaWS (`config/application.arch.yml:12`), chave do Google Maps (hardcoded e
# duplicada em `SFG/metadata.rb:8,9`) e o `secret_key_base`. Mais a chave privada DKIM
# (DEC-30/P-106).

# -----------------------------------------------------------------------------
# Identidade da aplicação
# -----------------------------------------------------------------------------
# ⚠ APP_NAME faz DOIS trabalhos incompatíveis: é o nome exibido em assunto de e-mail,
# corpo de e-mail, mensagem de WhatsApp e título da doc da API, E é o prefixo das filas
# do Sidekiq (`config/application.rb`, `config/sidekiq.yml`). Trocar o nome de exibição
# renomeia as filas e deixa job em fila órfã. Acoplamento registrado em
# `.migration-ai9/upstream-flags.md`; a separação é item do split (DEC-50).
APP_NAME=Safegold

RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# Hosts públicos (produção). APP_HOST vai nas URLs de e-mail; API_HOST é o host da API.
APP_HOST=              # ex.: app.safegold.com.br
API_HOST=              # ex.: api.safegold.com.br

# -----------------------------------------------------------------------------
# Banco de dados — NÃO passa por aqui
# -----------------------------------------------------------------------------
# Configuração de banco não é ENV neste repositório: ela vive em
# `config/database.yml`, que é local e não versionado (só o `.example` é). Se você
# procurou uma `DATABASE_URL` ou um `DB_HOST` aqui, é lá que está.
# Bancos: `sfg9_dev` / `sfg9_test`. `sfg9_prod` ainda não existe, porque o cutover não
# aconteceu (DEC-16: a primeira entrega é demonstração com dado fake).

# -----------------------------------------------------------------------------
# Segredos
# -----------------------------------------------------------------------------
SECRET_KEY_BASE=***
DEVISE_JWT_SECRET_KEY=***
CSRF_SECRET=***

# Chaves do Active Record Encryption — protegem `Credential#api_key`, que com o DEC-61
# passou a guardar também as chaves de terceiro (ReceitaWS, Google Maps). Vinham
# COMMITADAS como default no initializer da base; em produção não há default e o boot
# reprova sem elas. Gerar: `bin/rails db:encryption:init`.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=***
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=***
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=***

# Pula a checagem de obrigatórias. Só para build/precompile sem segredos injetados.
# SKIP_ENV_CHECK=false

# -----------------------------------------------------------------------------
# Sessão, JWT e CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_KEY=_sfg9_session
SESSION_SECURE=false
COOKIES_SAME_SITE=lax

# ⚠ O código lê JWT_EXPIRATION_TIME_MINUTES (Auth::TokenService e devise.rb).
# JWT_EXPIRATION_TIME sozinho não tinha efeito nenhum: valia o default de 21600
# minutos (15 DIAS). Os nomes abaixo são os que chegam ao código.
JWT_EXPIRATION_TIME_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
# TTL do token de handshake do Action Cable (cookie HttpOnly, escopo /cable)
JWT_CABLE_EXPIRATION_HOURS=12

# -----------------------------------------------------------------------------
# Rate limiting (Rack::Attack)
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Redis, filas e agendamento
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/1
SIDEKIQ_CONCURRENCY=5

# ⚠ Este Redis é compartilhado com o app `apl9`. As filas da sfg9 são prefixadas por
# APP_NAME (`config/sidekiq.yml`), mas o NAMESPACE DE CRON não é: `FLUSHDB` ou qualquer
# limpeza que não filtre derruba o cron do outro app. Ver `config/schedule.yml`.

# Retenção — DEC-60, DEC-90 e DEC-59. Os três jobs estão em `config/schedule.yml`,
# versionado, nunca cadastrados pela Web UI do Sidekiq.
LOGIN_ATTEMPTS_RETENTION_DAYS=90
EMAIL_LOGS_RETENTION_DAYS=180
# 1825 dias = 5 anos. Prazo maior porque é auditoria financeira e de acesso.
AUDIT_VERSIONS_RETENTION_DAYS=1825

# -----------------------------------------------------------------------------
# Servidor web
# -----------------------------------------------------------------------------
PORT=3000
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
PIDFILE=tmp/pids/server.pid
# 0 = processo único (default). Em produção, número de workers do cluster do Puma.
WEB_CONCURRENCY=0
FORCE_SSL=true

# -----------------------------------------------------------------------------
# Action Cable
# -----------------------------------------------------------------------------
ACTION_CABLE_URL=ws://localhost:3000/cable

# -----------------------------------------------------------------------------
# E-mail (SMTP)
# -----------------------------------------------------------------------------
SMTP_ADDRESS=              # host do servidor SMTP externo (ex.: smtp.sendgrid.net)
SMTP_PORT=587              # 587 para STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=***
SMTP_DOMAIN=
SMTP_AUTHENTICATION=login
SMTP_TLS_ENABLED=true
SMTP_DELIVERING=async
MAILER_FROM=               # ex.: no-reply@safegold.com.br
SMTP_SENDER=
DEVISE_MAILER_FROM=

# ⚠ MUDANÇA DE COMPORTAMENTO INTENCIONAL (OPS-626 / C-05): a verificação de
# certificado TLS agora é ATIVA por padrão. O legado a desligava globalmente no Windows
# (`config/initializers/ssl_for_win.rb:1`) e a própria base ai9 repetia o defeito em
# `production.rb:83` e `development.rb:58` com `openssl_verify_mode: 'none'`.
# Quem tem SMTP com certificado interno precisa declarar `none` AQUI, de propósito.
SMTP_OPENSSL_VERIFY_MODE=peer

# --- DKIM (S13 / OPS-485, OPS-608) -------------------------------------------
# Assinatura do e-mail que sai. **Sem `DKIM_DOMAIN` o interceptor não faz nada** —
# é o estado normal de desenvolvimento e de teste, e não uma degradação.
# Com domínio e SEM chave, o e-mail sai **sem assinatura** e o aviso vai para o
# log uma vez por processo: envio degradado, boot intacto. O legado lia a chave
# de um `.pem` VERSIONADO NO REPOSITÓRIO, com `open()` dentro do
# `config/application.rb` — arquivo ausente derrubava a aplicação inteira.
DKIM_DOMAIN=               # ex.: safegold.com.br. Vazio = DKIM desligado.
DKIM_SELECTOR=dk           # o `s=` do registro TXT `<selector>._domainkey.<domínio>`
# A chave privada, por UM dos dois caminhos. O segundo é o preferido: fica
# encriptada no banco (DEC-61) e é trocável por tela, sem deploy.
DKIM_PRIVATE_KEY=***       # PEM inteiro, com as quebras de linha. Ou…
#                            …cadastre um Credential de provedor `dkim`.

# -----------------------------------------------------------------------------
# OAuth
# -----------------------------------------------------------------------------
OAUTH_REDIRECT_URI=https://app/auth/callback
OAUTH_GOOGLE_REDIRECT_URI=https://app/auth/callback
FRONTEND_CALLBACK_URL=https://app/auth/callback

# OPS-605 — login social do Facebook permanece DESLIGADO. Com `false` (o default) a
# estratégia nem é registrada no OmniAuth: `/users/auth/facebook` responde 404 em vez
# de iniciar um fluxo que ninguém termina. No legado a chave existia e o botão não.
OAUTH_FACEBOOK_ENABLED=false
OAUTH_FACEBOOK_REDIRECT_URI=https://app/auth/callback

# -----------------------------------------------------------------------------
# Armazenamento de arquivos (ActiveStorage) — Q-07 EM ABERTO
# -----------------------------------------------------------------------------
# `Disk` grava dentro da árvore da aplicação: qualquer deploy que troque o diretório
# faz os anexos sumirem EM SILÊNCIO (o registro no banco continua apontando para um
# blob que não existe). Serve para a demo, não para o cutover (F-13).
# Enquanto Q-07 não for respondida, produção usa `disk_persistent` apontando para fora
# do release. Alvos prontos em `config/storage.yml`: amazon, s3_compatible.
ACTIVE_STORAGE_SERVICE=disk_persistent
ACTIVE_STORAGE_DISK_ROOT=/var/lib/sfg9/storage

# DEC-129.1 — `Disk` FICA, com o deploy garantindo um volume que sobrevive a redeploy.
# O ETL não passou a confiar: ele exige que alguém AFIRME o fato, com nome. A primeira
# variável diz o que está sendo afirmado (o volume é persistente — fato verificável, não
# permissão); a segunda dá autor à afirmação, como o `signed_by` de `db/etl/decisions.yml`.
# Afirmar sem assinar é recusado. Como conferir antes de preencher: runbook-cutover §1.4.1.
# Ficam VAZIAS aqui de propósito: quem preenche é quem conferiu, no servidor.
ACTIVE_STORAGE_DISK_VOLUME_IS_PERSISTENT=
ACTIVE_STORAGE_DISK_VOLUME_CONFIRMED_BY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_BUCKET=

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Chaves de terceiro — DEC-61
# -----------------------------------------------------------------------------
# O ALVO destas chaves NÃO é este arquivo: é o model `Credential`, encriptado por
# Active Record Encryption e gerenciável em `/admin/credentials` sem deploy (o cliente
# troca a própria chave da ReceitaWS, que é paga por consulta — DEC-46).
#
# As variáveis abaixo são o DEGRAU para ambiente que ainda não tem a credencial
# cadastrada (a demo sobe antes de o cliente informar a chave dele).
#
# A chave do Google Maps precisa chegar ao NAVEGADOR, e chave encriptada no banco não
# chega sozinha. Quem a entrega é `GET /api/v1/runtime_config`, autenticado — não o
# bundle do Vite. Restringir a chave por referrer/IP no Google Cloud continua sendo
# obrigatório: chave que vai para o navegador é pública por construção.
GOOGLE_MAPS_API_KEY=
RECEITAWS_API_TOKEN=

# -----------------------------------------------------------------------------
# Swagger / doc da API
# -----------------------------------------------------------------------------
SWAGGER_HOST=localhost:3000
SWAGGER_SCHEMES=http

# -----------------------------------------------------------------------------
# Integrações herdadas da base ai9 (não são do Safegold)
# -----------------------------------------------------------------------------
WHATS_SERVER_TYPE=https
WHATS_SERVER_URL=
WHATS_AUTHENTICATION_API_KEY=***

# ---------------------------------------------------------------------------
# WHATS_WEBHOOK_URL — para onde a Evolution nos avisa. **É o tempo real.**
# ---------------------------------------------------------------------------
# Base pública de `Api::Whats::V1::Webhooks`, SEM barra no fim:
#
#     https://<host-publico>/whats/v1/webhooks
#
# A Evolution acrescenta o evento em kebab-case (`/connection-update`,
# `/qrcode-updated`, `/logout-instance`), que é como os `resource` estão
# declarados. Vazio aqui faz o valor ser derivado de `API_HOST`.
#
# POR QUE ISTO EXISTE: até 26/08/2026 a URL só vinha do que alguém digitasse no
# formulário da tela de pareamento. O que ficou digitado foi `https://tst` — um
# placeholder — e a Evolution ficou com `enabled:false, events:[]`. Consequência:
# o celular pareava, nenhum `CONNECTION_UPDATE` chegava, nada era transmitido
# pelo Action Cable e a tela ficava parada sem erro nenhum. URL de webhook é
# configuração de ambiente, não campo de formulário.
#
# EM DESENVOLVIMENTO: a Evolution está na nuvem e NÃO alcança `localhost`. O
# registro é recusado de propósito quando a URL é loopback/rede privada
# (`PolemkWebhookService.publicly_reachable?`) — não só porque seria inútil, mas
# porque esta máquina fala com a MESMA Evolution de produção e um `set_webhook`
# local sobrescreveria o registro bom de todo mundo. Para exercitar o tempo real
# localmente, abra um túnel para a porta do backend e aponte esta variável para
# a URL do túnel. **A URL do túnel muda a cada abertura** — por isso ela mora
# aqui, e não no código nem no banco.
WHATS_WEBHOOK_URL=
WHATS_CORS_ORIGIN=*
WHATS_CORS_METHODS=GET,POST,PUT,DELETE
WHATS_CORS_CREDENTIALS=true
WHATS_LOG_LEVEL=ERROR,WARN,INFO
WHATS_LOG_COLOR=true
WHATS_CONFIG_SESSION_PHONE_CLIENT=
WHATS_CONFIG_SESSION_PHONE_NAME=Chrome
WHATS_LANGUAGE=pt-br

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=***

N8N_WEBHOOK_ADD_DISCORD=
N8N_WEBHOOK_REMOVE_DISCORD=
N8N_API_KEY=***
DISCORD_SERVER_URL=

ANTHROPIC_API_KEY=***
