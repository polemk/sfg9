<%#
  Layout de e-mail do Safegold.

  Cor literal aqui é INTENCIONAL e é a única exceção da casa à regra "cor só por
  token": cliente de e-mail não entende CSS custom property nem classe Tailwind,
  e vários (Outlook) descartam <style>. Os valores abaixo são exatamente os
  tokens da marca em `frontend/src/styles/globals.css`:
    ink        #2D2D2A   (--brand-ink)
    gold       #FFC107   (--brand-gold)
    gold deep  #EB9600   (--brand-gold-deep, o ouro do arquivo do logo)
  Se a marca mudar lá, mude aqui junto.

  O corpo é claro de propósito: o legado não tinha modo escuro e e-mail escuro
  é o que mais quebra em cliente antigo.
%>
<% ink        = '#2D2D2A' %>
<% gold       = '#FFC107' %>
<% gold_deep  = '#EB9600' %>
<% page_bg    = '#FAFAF9' %>
<% card_bg    = '#FFFFFF' %>
<% border     = '#E5E4DF' %>
<% text       = '#2D2D2A' %>
<% text_muted = '#63635C' %>
<% app_name   = ENV.fetch('APP_NAME', 'Safegold') %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= app_name %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&family=Fira+Mono:wght@500;700&display=swap" rel="stylesheet">
  </head>
  <body style="margin:0; padding:0; background-color:<%= page_bg %>; min-width:100%; font-family:'Work Sans', Arial, sans-serif;">
    <table width="100%" bgcolor="<%= page_bg %>" border="0" cellpadding="0" cellspacing="0" style="background-color:<%= page_bg %>; margin:0; padding:0; width:100%;">
      <tr>
        <td align="center" valign="top" style="padding:32px 16px;">
          <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; margin:0 auto; text-align:left;">

            <!-- Cabeçalho: a marca em texto. Imagem remota em e-mail cai em
                 bloqueio de imagem por padrão em boa parte dos clientes. -->
            <tr>
              <td style="padding-bottom:20px; text-align:center;">
                <span style="font-family:'Work Sans', Arial, sans-serif; font-size:22px; font-weight:700; letter-spacing:0.02em;">
                  <span style="color:<%= ink %>;">SAFE</span><span style="color:<%= gold_deep %>;">GOLD</span>
                </span>
              </td>
            </tr>

            <!-- Faixa de ouro -->
            <tr>
              <td style="height:4px; line-height:4px; font-size:0; background-color:<%= gold %>;">&nbsp;</td>
            </tr>

            <!-- Corpo -->
            <tr>
              <td style="padding-top:20px;">
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color:<%= card_bg %>; border-radius:12px; border:1px solid <%= border %>;">
                  <tr>
                    <td style="padding:32px;">
                      <%= yield %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Rodapé -->
            <tr>
              <td style="color:<%= text_muted %>; font-size:13px; line-height:1.6; text-align:center; padding-top:24px;">
                Se você não solicitou este acesso, ignore este e-mail.<br><br>
                &copy; <%= Date.today.year %> <%= app_name %>. Todos os direitos reservados.
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
