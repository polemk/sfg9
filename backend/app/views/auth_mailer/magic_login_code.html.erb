<%# Cor literal: ver a explicação no topo de `layouts/mailer.html.erb`. %>
<div style="text-align:center;">
  <h2 style="font-family:'Work Sans',Arial,sans-serif; color:#2D2D2A; font-size:22px; font-weight:600; letter-spacing:-0.01em; margin:0 0 16px;">Código de acesso</h2>
  <p style="color:#2D2D2A; font-size:16px; line-height:1.5; margin:0 0 8px;">Olá <strong><%= @user.name %></strong>,</p>
  <p style="color:#63635C; font-size:15px; line-height:1.5; margin:0 0 16px;">Use o código abaixo para entrar no Safegold:</p>

  <div style="background-color:#FAFAF9; border:1px solid #E5E4DF; border-radius:12px; padding:24px; text-align:center; margin:24px 0;">
    <span style="font-family:'Fira Mono',Consolas,monospace; font-size:38px; letter-spacing:10px; color:#2D2D2A; font-weight:700;"><%= @code %></span>
    <div style="font-size:12px; color:#63635C; margin-top:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em;">Expira em 5 minutos</div>
  </div>

  <div style="background-color:#FFF8E4; border:1px solid #FFC107; border-radius:8px; padding:16px; display:inline-block; text-align:left;">
    <strong style="color:#2D2D2A; font-size:14px;">Importante:</strong>
    <span style="color:#63635C; font-size:14px;">não compartilhe este código com ninguém.</span>
  </div>
</div>
