# Frontend Environment Variables
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/cable
VITE_APP_NAME=Safegold
VITE_APP_VERSION=1.0.0

# ATENCAO: estas duas alimentam o `connect-src` do CSP (ver `csp.config.ts`). CSP
# bloqueante com a origem errada aqui derruba a API e o Action Cable **em silencio** —
# recurso bloqueado nao produz erro visivel, so some.

# Theme Configuration
# ATENCAO: esta variavel NAO e lida por nenhum codigo. O tema padrao real e
# 'light', definido em src/store/themeStore.ts. Registrado em upstream-flags.md.
VITE_DEFAULT_THEME=light

# Feature Flags
VITE_ENABLE_ERROR_REPORTING=true

# ---------------------------------------------------------------------------
# Google Analytics — DEC-87. NASCE DESLIGADO.
# ---------------------------------------------------------------------------
# O snippet GA4 correto esta em `public/analytics-ga4.js` e so e referenciado pelo
# `index.html` quando VITE_GA_ENABLED=true. Mesmo ligado, ele NAO carrega o gtag.js
# ate haver consentimento explicito (Consent Mode v2, tudo negado por default).
#
# No legado o snippet e injetado na primeira linha de quatro entrypoints, sem
# consentimento nenhum — e esta quebrado: o ID e GA4 (`G-7E78XXZX5X`) e o snippet e
# Universal Analytics, entao hoje nao coleta absolutamente nada.
#
# SAO DUAS TRAVAS: ligar a coleta exige mexer AQUI **e** liberar
# `googletagmanager.com` / `google-analytics.com` em `csp.config.ts`. Uma so nao basta,
# de proposito — snippet de terceiro num sistema de credito e uma linha que alguem liga
# por engano.
VITE_GA_ENABLED=false
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google Maps — DEC-61
# ---------------------------------------------------------------------------
# A chave NAO vem mais daqui. Ela vive encriptada no model `Credential`
# (`/admin/credentials`, sem deploy) e chega ao navegador por
# `GET /api/v1/runtime_config`, autenticado.
#
# `VITE_GOOGLE_API_KEY` era o caminho antigo e assava a chave no bundle: qualquer um
# que baixasse o JS a tinha, e trocar exigia um build. Mantida apenas como degrau para
# ambiente que ainda nao cadastrou a credencial; o backend a le como fallback pela ENV
# `GOOGLE_MAPS_API_KEY`, nao por esta.
#
# Independente de onde ela esteja: chave que vai para o navegador e publica por
# construcao. A protecao real e a restricao por referrer/IP no Google Cloud, e a chave
# do legado (hardcoded em `SFG/metadata.rb:8,9`) precisa ser ROTACIONADA no cutover.
VITE_GOOGLE_API_KEY=

# Build Configuration
VITE_BUILD_MODE=development

# Discord
VITE_DISCORD_SERVER_URL=https://discord.gg/your-server-invite
